# Copy to .env and adjust as needed. Docker Compose reads .env automatically.
# Never commit the real .env file.

# MySQL (published on DB_PORT so a system MySQL on 3306 is left alone)
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=root

# Grafana UI at http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Optional `quality` profile: SonarQube at http://localhost:9000,
# Nexus at http://localhost:8081.
SONAR_DB_PASSWORD=sonar
# Create a token in SonarQube -> My Account -> Security, then paste it here.
SONAR_TOKEN=
# After the first Nexus login, replace admin123 with the password you chose.
NEXUS_USER=admin
NEXUS_PASSWORD=admin123
